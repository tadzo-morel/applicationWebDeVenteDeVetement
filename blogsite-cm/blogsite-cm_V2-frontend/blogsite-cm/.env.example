# ============================================================
# Variables d'environnement — boutique blogSite
# Copier ce fichier vers .env :
#   Linux/Mac : cp .env.example .env
#   Windows   : copy .env.example .env
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
DB_NAME=blogsite_db
DB_USER=boutique
DB_PASSWORD=boutique
MYSQL_HOST_PORT=3306

# ---------- Backend Spring Boot ----------
BACKEND_PORT=8080

# JWT — minimum 64 caractères pour HMAC-SHA512
JWT_SECRET=changeme-au-moins-64-caracteres-pour-le-developpement-local-blogsite-cm-2026

# CORS - origines autorisees
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# ---------- Frontend ----------
FRONTEND_PORT=4200

# ---------- WhatsApp Business ----------
WHATSAPP_BUSINESS_NUMBER=237670000000
